<Window x:Class="VMS.Frontend.WPF.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VMS.Frontend.WPF.Converters"
        Title="{DynamicResource Win_AddUser_Title}" Height="580" Width="380"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/><RowDefinition Height="160"/>
            <RowDefinition Height="2"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource AddUser_Username}" Foreground="{StaticResource TextSecondary}"/>
        <TextBox Grid.Row="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Text="{DynamicResource AddUser_Password}" Foreground="{StaticResource TextSecondary}"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Text="{DynamicResource AddUser_Role}" Foreground="{StaticResource TextSecondary}"/>
        <ComboBox Grid.Row="5" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="7" Text="{DynamicResource AddUser_Permissions}" Foreground="{StaticResource TextSecondary}"/>
        <Border Grid.Row="9" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PermissionOptions}" Margin="8,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="11" Text="{DynamicResource AddUser_PermissionsHint}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="13" Text="{Binding ErrorMessage}" Foreground="{StaticResource TextError}" TextWrapping="Wrap"/>

        <Button Grid.Row="15" Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource AddUser_Submit}" Height="32" Click="OnSaveClick"/>
    </Grid>
</Window>
