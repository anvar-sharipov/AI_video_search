<Window x:Class="VMS.Frontend.WPF.Views.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="{DynamicResource Win_Archive_Title}" Height="780" Width="950"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="OnLoaded">
    <Grid Margin="16">
        <!-- Video (a native HwndHost surface via vlc:VideoView) always paints on top of any WPF
             content, ignoring Grid clipping/ordering — the classic WPF "airspace" limitation. It
             has to be the last/bottom-most row with nothing WPF-rendered below it, which is why
             the timeline and transport controls sit above it here instead of below like a typical
             NVR layout. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Controls card — same bordered-panel look as the sidebar/search panels elsewhere in the client. -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Archive_CameraLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Archive_DateLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource Archive_TimeLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>

                    <ComboBox Grid.Row="2" Grid.Column="0" Height="30" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Row="2" Grid.Column="2" Height="30" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="yyyy-MM-dd"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Height="30" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="HH:mm"/>
                    <Button Grid.Row="2" Grid.Column="6" Style="{StaticResource AccentButtonStyle}" Width="110" Height="30" Content="{DynamicResource Archive_PlayButton}" Command="{Binding PlayCommand}"/>
                </Grid>

                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11">
                    <Run Text="{DynamicResource Archive_CoverageLabel}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CoverageSummary, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Day timeline — click anywhere to jump playback there, like a typical NVR's recording timeline. Coverage
             segments (from ArchiveViewModel.TimelineSegments) show where footage actually exists on the selected day. -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8" Margin="0,0,0,12">
            <StackPanel>
                <Canvas Height="16" Width="880">
                    <ItemsControl ItemsSource="{Binding HourMarks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                           Canvas.Left="{Binding Left}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <Border x:Name="TimelineTrack" Width="880" Height="28" Margin="0,4,0,0"
                        Background="{StaticResource BgTree}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonDown="OnTimelineClick">
                    <Canvas ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding TimelineSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="{StaticResource AccentBlue}" Height="26"
                                               Canvas.Left="{Binding Left}" Width="{Binding Width}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Fill="{StaticResource AccentAmber}" Width="2" Height="26" Canvas.Left="{Binding CursorLeft}"/>
                    </Canvas>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{DynamicResource Archive_PreviousButton}" Width="110" Margin="0,0,8,0" Command="{Binding PreviousCommand}"/>
                <Button Width="90" Margin="0,0,8,0" Command="{Binding TogglePauseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatDarkButtonStyle}">
                            <Setter Property="Content" Value="{DynamicResource Archive_PauseButton}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="{DynamicResource Archive_ResumeButton}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Archive_NextButton}" Width="110" Command="{Binding NextCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Background="Black">
            <vlc:VideoView MediaPlayer="{Binding Player}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextError}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" MaxWidth="500"/>
        </Grid>
    </Grid>
</Window>
