<Window x:Class="VMS.Frontend.WPF.Views.CameraManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VMS.Frontend.WPF.Converters"
        Title="{DynamicResource Win_CameraManagement_Title}" Height="780" Width="900"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <Window.Resources>
        <conv:CameraStatusConverter x:Key="CameraStatus"/>
        <conv:CameraStatusColorConverter x:Key="CameraStatusColor"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="120"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- Managed Device -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            <TextBox Grid.Column="1" Width="200" VerticalContentAlignment="Center" Height="28"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource CameraManagement_SearchTooltip}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Padding="10,6" Margin="0,0,4,0" Content="{DynamicResource Main_AddCameraButton}" Click="OnAddClick"/>
            <Button Padding="10,6" Margin="0,0,4,0" Command="{Binding EditSelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource CameraManagement_EditButton}"/>
                </StackPanel>
            </Button>
            <Button Padding="10,6" Command="{Binding DeleteSelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource CameraManagement_DeleteButton}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding CamerasView}" AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  PreviewMouseLeftButtonDown="OnCheckBoxCellPreviewMouseLeftButtonDown">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="32" IsReadOnly="False"/>
                <DataGridTextColumn Header="{DynamicResource CameraManagement_ColumnCode}" Binding="{Binding Camera.Code}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource CameraManagement_ColumnName}" Binding="{Binding Camera.Name}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource CameraManagement_ColumnIp}" Binding="{Binding Camera.IpAddress}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource CameraManagement_ColumnPort}" Binding="{Binding Camera.OnvifPort}" Width="70" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="{DynamicResource CameraManagement_ColumnStatus}" Width="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="2,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <MultiBinding Converter="{StaticResource CameraStatusColor}">
                                            <Binding Path="Camera.IsEnabled"/>
                                            <Binding Path="Camera.Running"/>
                                        </MultiBinding>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CameraStatus}">
                                            <Binding Path="Camera.IsEnabled"/>
                                            <Binding Path="Camera.Running"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Height="6" Background="{StaticResource BorderSubtle}" ResizeBehavior="PreviousAndNext"/>

        <!-- Online Device: devices found on the LAN via ONVIF WS-Discovery that aren't in the
             Managed Device list yet — select one and Add, credentials only, IP is already known. -->
        <Grid Grid.Row="4" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                       Text="{Binding DiscoveryStatusMessage}" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Padding="10,6" Margin="0,0,4,0" Content="{DynamicResource Main_AddCameraButton}" Command="{Binding AddSelectedDiscoveredCommand}"/>
            <Button Padding="10,6" Command="{Binding RefreshDiscoveryCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource CameraManagement_RefreshButton}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <DataGrid Grid.Row="6" ItemsSource="{Binding OnlineDevices}" AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  PreviewMouseLeftButtonDown="OnCheckBoxCellPreviewMouseLeftButtonDown">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="32" IsReadOnly="False"/>
                <DataGridTextColumn Header="{DynamicResource CameraManagement_ColumnIp}" Binding="{Binding Device.IpAddress}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource CameraManagement_ColumnPort}" Binding="{Binding Device.OnvifPort}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource CameraManagement_ColumnModel}" Binding="{Binding Device.Model}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
