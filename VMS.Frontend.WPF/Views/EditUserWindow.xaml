<Window x:Class="VMS.Frontend.WPF.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VMS.Frontend.WPF.Converters"
        Title="{DynamicResource Win_EditUser_Title}" Height="620" Width="380"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Username label -->
            <RowDefinition Height="Auto"/> <!-- 1: Username value -->
            <RowDefinition Height="Auto"/> <!-- 2: Role label -->
            <RowDefinition Height="Auto"/> <!-- 3: Role combo -->
            <RowDefinition Height="Auto"/> <!-- 4: Password label -->
            <RowDefinition Height="Auto"/> <!-- 5: Password box -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/> <!-- 7: Permissions label -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="160"/> <!-- 9: Permissions list -->
            <RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/> <!-- 11: Permissions hint -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/> <!-- 13: IsActive checkbox -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/> <!-- 15: ErrorMessage -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/> <!-- 17: Submit button -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource AddUser_Username}" Foreground="{StaticResource TextSecondary}"/>
        <TextBlock Grid.Row="1" Text="{Binding Username}" Margin="0,0,0,8" Foreground="{StaticResource TextDisabled}"/>

        <TextBlock Grid.Row="2" Text="{DynamicResource AddUser_Role}" Foreground="{StaticResource TextSecondary}"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Text="{DynamicResource EditUser_NewPassword}" Foreground="{StaticResource TextSecondary}"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="5" ToolTip="{DynamicResource EditUser_NewPasswordHint}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="7" Text="{DynamicResource AddUser_Permissions}" Foreground="{StaticResource TextSecondary}"/>
        <Border Grid.Row="9" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PermissionOptions}" Margin="8,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="11" Text="{DynamicResource AddUser_PermissionsHint}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/>

        <CheckBox Grid.Row="13" Content="{DynamicResource EditUser_IsActiveLabel}" IsChecked="{Binding IsActive}" Foreground="{StaticResource TextPrimary}"/>

        <TextBlock Grid.Row="15" Text="{Binding ErrorMessage}" Foreground="{StaticResource TextError}" TextWrapping="Wrap"/>

        <Button Grid.Row="17" Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource EditUser_Submit}" Height="32" Click="OnSaveClick"/>
    </Grid>
</Window>
