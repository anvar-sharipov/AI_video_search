<Window x:Class="VMS.Frontend.WPF.Views.ExpandedCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="{Binding Name}" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar, not the video: a native HwndHost video surface always wins mouse input
             over WPF content drawn "on top" of it (see the same note on grid tile headers in
             MainWindow.xaml) — so the double-click target lives in its own non-overlapping row
             instead of floating over the VideoView. Double-click here mirrors the double-click
             that opened this window (see CameraTileHeader_MouseDoubleClick in MainWindow), so
             expand and collapse use the same gesture; Esc remains the single-click-equivalent
             fallback (see KeyDown in the code-behind). -->
        <Button Grid.Row="0" Background="#222" Foreground="White" BorderThickness="0"
                HorizontalContentAlignment="Stretch" Cursor="Hand"
                MouseDoubleClick="Header_MouseDoubleClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Padding="12,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource Expand_CloseButton}" Padding="12,8" VerticalAlignment="Center"/>
            </Grid>
        </Button>

        <vlc:VideoView Grid.Row="1" MediaPlayer="{Binding Player}" Loaded="VideoView_Loaded"/>
    </Grid>
</Window>
