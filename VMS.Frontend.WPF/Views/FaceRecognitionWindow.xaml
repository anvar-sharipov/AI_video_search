<Window x:Class="VMS.Frontend.WPF.Views.FaceRecognitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VMS.Frontend.WPF.ViewModels"
        xmlns:api="clr-namespace:VMS.Frontend.WPF.Api"
        Title="{DynamicResource Win_FaceRecognition_Title}" Height="640" Width="900"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource FaceRecognition_KnownPersonsHeading}" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding KnownPersons}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type api:KnownPersonDto}">
                        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="✕" Width="24"
                                        Command="{Binding DataContext.DeleteKnownPersonCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource FaceRecognition_RecognizedHeading}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="{DynamicResource AlarmRecords_RefreshButton}" Width="90" Command="{Binding RefreshCommand}"/>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding RecognizedHits}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="{DynamicResource Search_ClipButton}" Width="60"
                                        Command="{Binding DataContext.ViewClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource TextError}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</Window>
