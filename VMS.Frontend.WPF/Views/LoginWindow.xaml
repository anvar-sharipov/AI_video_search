<Window x:Class="VMS.Frontend.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Win_Login_Title}" Height="310" Width="380"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="RU" Padding="8,2" Margin="0,0,4,0" Command="{Binding SetLanguageCommand}" CommandParameter="ru"/>
            <Button Content="EN" Padding="8,2" Margin="0,0,4,0" Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
            <Button Content="TM" Padding="8,2" Command="{Binding SetLanguageCommand}" CommandParameter="tk"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{DynamicResource Login_Heading}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="4" Text="{DynamicResource Login_UsernameLabel}" Foreground="{StaticResource TextSecondary}"/>
        <TextBox Grid.Row="5" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Text="{DynamicResource Login_PasswordLabel}" Foreground="{StaticResource TextSecondary}"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="8"/>

        <TextBlock Grid.Row="10" Text="{Binding ErrorMessage}" Foreground="{StaticResource TextError}" TextWrapping="Wrap"/>

        <Button Grid.Row="12" Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource Login_Submit}" Height="32" Click="OnLoginClick" IsDefault="True"/>
    </Grid>
</Window>
