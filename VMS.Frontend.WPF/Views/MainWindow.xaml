<Window x:Class="VMS.Frontend.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:vm="clr-namespace:VMS.Frontend.WPF.ViewModels"
        xmlns:conv="clr-namespace:VMS.Frontend.WPF.Converters"
        Title="{DynamicResource Win_Main_Title}" Height="800" Width="1280"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="BoolToVisInverse"/>
        <conv:BoolToTileBorderBrushConverter x:Key="TileBorderBrush"/>
        <conv:BoolToTileBorderThicknessConverter x:Key="TileBorderThickness"/>
        <conv:GridSizeToLabelConverter x:Key="GridSizeToLabel"/>
        <conv:FractionToPixelConverter x:Key="FractionToPixel"/>

        <!-- Flat header-bar button style — used for the clickable strip above each video tile,
             and for the layout-switcher toolbar buttons. -->
        <Style x:Key="TileHeaderButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="6,4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-bar screen tab (Control Panel / Live View) — active tab gets a highlighted background and accent text. -->
        <Style x:Key="ScreenTabButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatDarkButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Control Panel dashboard card. -->
        <Style x:Key="DashboardCardStyle" TargetType="Button" BasedOn="{StaticResource FlatDarkButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:CameraTileViewModel}">
            <Border BorderBrush="{Binding IsSelected, Converter={StaticResource TileBorderBrush}}"
                    BorderThickness="{Binding IsSelected, Converter={StaticResource TileBorderThickness}}"
                    Margin="2" Background="{StaticResource BgTileEmpty}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Click the NAME BAR, not the video: VideoView hosts a native child window
                         (HwndHost) for D3D rendering, and native child windows always win mouse
                         input over anything WPF draws "on top" of them in XAML order — a WPF
                         element layered over the video is never actually clickable there. Putting
                         the click target in its own row, outside the video's bounds entirely,
                         sidesteps that airspace problem rather than fighting it. -->
                    <Grid Grid.Row="0" Background="{StaticResource BgToolbar}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource TileHeaderButtonStyle}"
                                Background="Transparent" Cursor="Hand" HorizontalContentAlignment="Left"
                                ToolTip="{DynamicResource Tile_SelectTooltip}"
                                Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                MouseDoubleClick="CameraTileHeader_MouseDoubleClick">
                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource TileHeaderButtonStyle}"
                                Background="Transparent" Cursor="Hand"
                                ToolTip="{DynamicResource Tile_ExpandTooltip}"
                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="⤢" Foreground="White" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- Hidden (not just covered) while frozen: LibVLC's D3D surface can be left
                         showing a torn/stale last frame after the freeze watchdog's Stop() call
                         (see CameraTileViewModel.CheckFrozen), and a native HwndHost always wins
                         airspace over anything WPF draws on top of it — so the only way to
                         actually get rid of that stray frame is to collapse the VideoView itself,
                         not layer something over it. -->
                    <vlc:VideoView Grid.Row="1" MediaPlayer="{Binding Player}" Loaded="TileVideoView_Loaded"
                                   MouseLeftButtonDown="CameraTileVideo_MouseLeftButtonDown"
                                   Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVisInverse}}"/>

                    <!-- Reconnect button: left side of the tile, only while frozen (see IsFrozen doc
                         comment on CameraTileViewModel). No airspace conflict with the VideoView
                         here since it's collapsed, not just hidden-behind, whenever this is visible. -->
                    <Button Grid.Row="1" Style="{StaticResource TileHeaderButtonStyle}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                            Background="#CC1E1E1E" Cursor="Hand"
                            Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}"
                            ToolTip="{DynamicResource Tile_ReconnectTooltip}"
                            Command="{Binding ReconnectCommand}">
                        <TextBlock Text="⟳" Foreground="White" FontSize="20"/>
                    </Button>

                    <!-- Live known/unknown overlay (see CameraTileViewModel.DetectionBoxes) — a
                         purely visual layer (IsHitTestVisible=False): the VideoView beneath it is
                         a native HwndHost and always wins mouse input regardless of z-order (see
                         the click-target note above), so this never needs to be clickable. -->
                    <Canvas Grid.Row="1" x:Name="DetectionOverlay" Background="Transparent" IsHitTestVisible="False">
                        <ItemsControl ItemsSource="{Binding DetectionBoxes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LiveDetectionBoxViewModel}">
                                    <Grid>
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource FractionToPixel}">
                                                <Binding Path="X"/>
                                                <Binding ElementName="DetectionOverlay" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource FractionToPixel}">
                                                <Binding Path="Y"/>
                                                <Binding ElementName="DetectionOverlay" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <Rectangle Stroke="{Binding StrokeBrush}" StrokeThickness="2">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource FractionToPixel}">
                                                    <Binding Path="Width"/>
                                                    <Binding ElementName="DetectionOverlay" Path="ActualWidth"/>
                                                </MultiBinding>
                                            </Rectangle.Width>
                                            <Rectangle.Height>
                                                <MultiBinding Converter="{StaticResource FractionToPixel}">
                                                    <Binding Path="Height"/>
                                                    <Binding ElementName="DetectionOverlay" Path="ActualHeight"/>
                                                </MultiBinding>
                                            </Rectangle.Height>
                                        </Rectangle>
                                        <Border Background="#CC000000" Padding="3,0" Margin="0,-16,0,0"
                                                VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding StrokeBrush}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One grid cell. Tile != null reuses the CameraTileViewModel template above verbatim via
             ContentPresenter; an empty cell (fixed layouts only — Auto never has one) shows a
             clickable placeholder that becomes the assignment target for a tree double-click. -->
        <DataTemplate DataType="{x:Type vm:GridSlotViewModel}">
            <Grid>
                <ContentPresenter Content="{Binding Tile}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInverse}}"/>
                <Button Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border BorderBrush="{Binding IsSelected, Converter={StaticResource TileBorderBrush}}"
                                                BorderThickness="{Binding IsSelected, Converter={StaticResource TileBorderThickness}}"
                                                Margin="2" Background="{StaticResource BgTileEmpty}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📹" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextDisabled}"/>
                                                <TextBlock Text="{DynamicResource Slot_EmptyPlaceholderHint}" Foreground="{StaticResource TextDisabled}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar: screen tabs (Control Panel / Live View) + language toggle + user -->
        <Grid DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="{DynamicResource Tab_ControlPanel}" Command="{Binding ShowControlPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ScreenTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsControlPanelActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgToolbar}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Tab_LiveView}" Command="{Binding ShowLiveViewCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ScreenTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveViewActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgToolbar}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Language toggle -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="RU" Padding="8,4" Margin="0,0,2,0" Command="{Binding SetLanguageCommand}" CommandParameter="ru"/>
                <Button Content="EN" Padding="8,4" Margin="0,0,2,0" Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                <Button Content="TM" Padding="8,4" Command="{Binding SetLanguageCommand}" CommandParameter="tk"/>
            </StackPanel>

            <!-- Light/Dark toggle -->
            <Button Grid.Column="3" Padding="8,4" VerticalAlignment="Center" Command="{Binding ToggleThemeCommand}"
                    AutomationProperties.AutomationId="ThemeToggleButton"
                    Content="{DynamicResource Theme_SwitchToLight}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FlatDarkButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Theme.IsDarkTheme}" Value="False">
                                <Setter Property="Content" Value="{DynamicResource Theme_SwitchToDark}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="12,0">
                <Run Text="{Binding Session.Username, Mode=OneWay}"/>
                <Run Text=" ("/>
                <Run Text="{Binding Session.Role, Mode=OneWay}"/>
                <Run Text=")"/>
            </TextBlock>

            <Button Grid.Column="5" Content="{DynamicResource Common_LogOut}" Padding="10,4" Margin="0,0,8,0"
                    VerticalAlignment="Center" Command="{Binding LogOutCommand}"/>
        </Grid>

        <!-- The two top-level screens occupy the same area; only one is visible at a time. -->
        <Grid>
            <!-- Control Panel: a dashboard grid of feature cards, matching a typical VMS client's
                 landing screen. Every card here is wired to a real command. -->
            <Grid Visibility="{Binding IsControlPanelActive, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource BgWindow}">
                <StackPanel Grid.Column="0" Margin="16">
                    <TextBlock Text="{DynamicResource ControlPanel_CommonHeading}" FontFamily="Georgia" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="4">
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowLiveViewCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="📹" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_LiveView_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_LiveView_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowArchiveCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_Playback_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_Playback_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowVideoWallCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="⊞" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_VideoWall_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_VideoWall_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowAudioCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="🎙" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_Audio_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_Audio_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowEMapCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="📍" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_Emap_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_Emap_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowPeopleCountingCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_PeopleCounting_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_PeopleCounting_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowFaceRecognitionCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="🙂" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_FaceRecognition_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_FaceRecognition_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowPersonSightingReportCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="🧾" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_PersonSightingReport_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_PersonSightingReport_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowAlarmRecordsCommand}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="🚨" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_AlarmRecords_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_AlarmRecords_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowCameraManagementCommand}"
                                Visibility="{Binding Session.CanManageCameras, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="🖧" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Card_DeviceManagement_Title}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_DeviceManagement_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowUserManagementCommand}"
                                Visibility="{Binding Session.CanManageUsers, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="👥" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Nav_UserManagement}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_UserManagement_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DashboardCardStyle}" Command="{Binding ShowOperationLogCommand}"
                                Visibility="{Binding Session.CanViewAuditLog, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource BgIconRail}" HorizontalAlignment="Center">
                                    <TextBlock Text="📜" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Nav_OperationLog}" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Card_OperationLog_Desc}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- Live View: the camera grid screen (everything that existed before Control Panel was added). -->
            <DockPanel Visibility="{Binding IsLiveViewActive, Converter={StaticResource BoolToVis}}">
                <!-- Left sidebar: icon rail + camera tree. Single-click a camera to highlight its
                     tile (if shown); double-click assigns it into the currently-selected grid
                     cell — only meaningful in a fixed NxN layout (see AssignCameraToSelectedSlot). -->
                <Grid DockPanel.Dock="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Background="{StaticResource BgIconRail}">
                        <Button Style="{StaticResource IconButtonStyle}" Content="📹"
                                Command="{Binding ShowCameraGroupsCommand}" ToolTip="{DynamicResource Sidebar_GroupsTooltip}"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="⊞"
                                Command="{Binding ShowQuickGroupSwitchCommand}" ToolTip="{DynamicResource Sidebar_QuickSwitchTooltip}"/>
                        <Button Content="🕐"
                                Command="{Binding ToggleAlarmFilterCommand}" ToolTip="{DynamicResource Sidebar_AlarmFilterTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlarmFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentAmber}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="1" Background="{StaticResource BgTree}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Margin="8" Height="28" VerticalContentAlignment="Center"
                                 Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Sidebar_SearchPlaceholder}"/>

                        <!-- Plain ItemsControl, not ListBox: the themed ListBox/ListBoxItem control
                             templates force their own disabled-state background that a Background
                             setter can't override, and rows here are plain Buttons anyway (no need
                             for ListBox's own selection machinery). -->
                        <Border Grid.Row="1" Margin="8,0,8,8" Background="{StaticResource BgTree}">
                            <ItemsControl ItemsSource="{Binding TreeCamerasView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CameraTileViewModel}">
                                        <Button HorizontalContentAlignment="Left" Cursor="Hand"
                                                ToolTip="{DynamicResource Tree_AssignHintTooltip}"
                                                Command="{Binding DataContext.SelectTileFromTreeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                MouseDoubleClick="TreeCameraItem_MouseDoubleClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TileHeaderButtonStyle}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BgToolbar}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Name}" Padding="4,6" Foreground="{StaticResource TextPrimary}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Bottom toolbar: per-camera manual capture and playback transport. ✕ always acts on every
                     tile; Snapshot/Record/PlayPause/Fullscreen act on SelectedTile (enabled only once a tile
                     is selected via its header — see MainViewModel.HasSelectedTile). ⏮/⏭ (archive-fragment
                     stepping) stay stubbed — no archive-scrubbing transport exists yet. -->
                <Grid DockPanel.Dock="Bottom" Background="{StaticResource BgToolbar}" Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" Content="✕"
                                Command="{Binding StopAllCommand}" ToolTip="{DynamicResource Bottom_StopAllTooltip}"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="📷"
                                Command="{Binding SnapshotCommand}" IsEnabled="{Binding HasSelectedTile}"
                                ToolTip="{DynamicResource Bottom_SnapshotTooltip}"/>
                        <Button Content="⏺"
                                Command="{Binding RecordCommand}" IsEnabled="{Binding HasSelectedTile}"
                                ToolTip="{DynamicResource Bottom_RecordTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTile.IsRecording}" Value="True">
                                            <Setter Property="Foreground" Value="#FF5C5C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Content="⏮" IsEnabled="False" ToolTip="{DynamicResource Bottom_PrevTooltip}"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="⏸"
                                Command="{Binding PlayPauseCommand}" IsEnabled="{Binding HasSelectedTile}"
                                ToolTip="{DynamicResource Bottom_PlayPauseTooltip}"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="⏭" IsEnabled="False" ToolTip="{DynamicResource Bottom_NextTooltip}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="⛶"
                            Command="{Binding FullscreenCommand}" IsEnabled="{Binding HasSelectedTile}"
                            ToolTip="{DynamicResource Bottom_FullscreenTooltip}"/>
                </Grid>

                <!-- Layout-switcher toolbar (1x1/2x2/3x3/4x4) + text/photo search, centered in the
                     space to the right of the layout buttons. Search results drop down from the
                     search box (Popup) instead of reserving a permanent side panel, so the camera
                     grid gets the full width. -->
                <Grid DockPanel.Dock="Top" Background="{StaticResource BgIconRail}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ComboBox Width="90" ItemsSource="{Binding GridSizeOptions}" SelectedItem="{Binding GridSize}"
                                  ToolTip="{DynamicResource Layout_GridSizeTooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource GridSizeToLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="SearchAreaPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBox x:Name="LiveSearchBox" Width="260" Height="28" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Search_PlaceholderTooltip}"/>
                        <Button Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource Search_Button}" Margin="4,0,0,0" Width="70"
                                Command="{Binding SearchCommand}"/>
                        <Button Content="📷" Width="28" Height="28" Margin="4,0,0,0"
                                ToolTip="{DynamicResource SearchByPhoto_ButtonTooltip}"
                                Command="{Binding SearchByPhotoCommand}"
                                Visibility="{Binding Session.CanSearchByFace, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- Search-results dropdown: a plain in-layout element, not a WPF Popup. This app
                     is explicitly built to be watched/operated over RDP (see App.xaml.cs's
                     SoftwareOnly render mode) — a Popup is its own separate top-level window, and
                     that class of window is a known weak point for real mouse input over RDP
                     (works fine for locally-injected clicks, which is why automated testing here
                     never caught it). A plain element in the main window's own visual tree has no
                     such problem. This does push the camera grid down slightly while open —
                     accepted trade-off for something that reliably responds to a real click. -->
                <Border x:Name="SearchResultsPanel" DockPanel.Dock="Top"
                        Background="{StaticResource BgTree}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                        Visibility="{Binding IsSearchResultsOpen, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                                <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{DynamicResource Search_ClipButton}" Width="50" Margin="0,0,4,0"
                                                Command="{Binding DataContext.ViewClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="2" Content="{DynamicResource Search_ProtectButton}" Width="70"
                                                ToolTip="{DynamicResource Search_ProtectTooltip}"
                                                Command="{Binding DataContext.ProtectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.Session.CanManageCameras, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Live camera grid -->
                <ItemsControl x:Name="CameraGrid" Background="{StaticResource BgWindow}" ItemsSource="{Binding GridSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataContext.GridSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Columns="{Binding DataContext.GridSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
