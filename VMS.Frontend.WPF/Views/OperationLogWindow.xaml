<Window x:Class="VMS.Frontend.WPF.Views.OperationLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Win_OperationLog_Title}" Height="560" Width="900"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" Foreground="{StaticResource TextError}" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource OperationLog_ColumnTimestamp}" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                <DataGridTextColumn Header="{DynamicResource OperationLog_ColumnUser}" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource OperationLog_ColumnAction}" Binding="{Binding Action}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource OperationLog_ColumnTarget}" Binding="{Binding TargetType}" Width="100"/>
                <DataGridTextColumn Header="{DynamicResource OperationLog_ColumnDetails}" Binding="{Binding Details}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource OperationLog_ColumnResult}" Binding="{Binding IsSuccess}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
