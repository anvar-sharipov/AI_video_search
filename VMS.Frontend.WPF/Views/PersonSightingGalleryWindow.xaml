<Window x:Class="VMS.Frontend.WPF.Views.PersonSightingGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VMS.Frontend.WPF.Converters"
        Title="{Binding HeaderText}" Height="600" Width="780"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:ByteArrayToBitmapImageConverter x:Key="BytesToImage"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="{DynamicResource PersonSightingGallery_DownloadButton}" HorizontalAlignment="Left"
                Padding="10,6" Margin="0,0,0,10" Click="OnDownloadClick"/>

        <TextBlock Grid.Row="1" Text="{DynamicResource PersonSightingGallery_Loading}" Foreground="{StaticResource TextSecondary}"
                   Visibility="{Binding IsBusy, Converter={StaticResource NullToVis}}" VerticalAlignment="Top"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="4">
                            <StackPanel Width="150">
                                <Grid Height="110">
                                    <Image Source="{Binding Bytes, Converter={StaticResource BytesToImage}}" Stretch="Uniform"
                                           Visibility="{Binding Bytes, Converter={StaticResource NullToVis}}"/>
                                    <TextBlock Text="{DynamicResource PersonSightingGallery_NoImage}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Bytes, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"/>
                                    <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                            Background="#CC000000" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                            ToolTip="{DynamicResource PersonSightingGallery_DeleteTooltip}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource TextError}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
