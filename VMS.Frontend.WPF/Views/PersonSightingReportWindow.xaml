<Window x:Class="VMS.Frontend.WPF.Views.PersonSightingReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VMS.Frontend.WPF.Converters"
        Title="{DynamicResource Win_PersonSightingReport_Title}" Height="680" Width="940"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="ReportGrid" Grid.Row="0" ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      MouseDoubleClick="ReportGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource PersonSightingReport_CameraColumn}" Binding="{Binding CameraName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource PersonSightingReport_DateColumn}" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn Header="{DynamicResource PersonSightingReport_TotalColumn}" Binding="{Binding Total}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource PersonSightingReport_KnownColumn}" Binding="{Binding Known}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource PersonSightingReport_UnknownColumn}" Binding="{Binding Unknown}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1" Text="{DynamicResource PersonSightingReport_DrillDownHint}"
                       Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,0"/>
        </Grid>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <TextBlock Text="{DynamicResource PersonSightingReport_CamerasLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Height="220" Margin="0,0,0,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <CheckBox Content="{DynamicResource PersonSightingReport_SelectAll}" IsChecked="{Binding SelectAllCameras}"
                                  Foreground="{StaticResource TextSecondary}" FontStyle="Italic" Margin="0,0,0,4"/>
                        <Separator Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Cameras}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="{StaticResource TextPrimary}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock Text="{DynamicResource PersonSightingReport_CamerasHint}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Archive_DateLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,0,8"/>
            <DatePicker SelectedDate="{Binding ToDate}" Margin="0,0,0,8"/>

            <Button Content="{DynamicResource PeopleCounting_QueryButton}" Height="30" Command="{Binding QueryCommand}" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource PersonSightingReport_Loading}" Foreground="{StaticResource TextSecondary}" FontSize="11"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextError}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
