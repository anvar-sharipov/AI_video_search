<Window x:Class="VMS.Frontend.WPF.Views.VideoWallLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Win_VideoWall_Title}" Height="330" Width="420"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource VideoWall_MonitorLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
        <!-- ItemTemplate, not DisplayMemberPath: the app's custom dark ComboBox template (DarkTheme.xaml)
             binds its closed-box text to SelectionBoxItem/SelectionBoxItemTemplate, which WPF only
             populates from an explicit ItemTemplate — DisplayMemberPath alone renders the item's raw
             ToString() there (same fix already used by PeopleCountingWindow's camera picker). -->
        <ComboBox Grid.Row="1" Height="30" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="{DynamicResource VideoWall_LayoutLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="4" Height="30" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Row="6" Padding="10,6" HorizontalAlignment="Left" Content="{DynamicResource VideoWall_ManageLayoutsButton}"
                Command="{Binding ManageLayoutsCommand}"/>

        <TextBlock Grid.Row="8" Text="{DynamicResource VideoWall_Hint}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="9" Text="{Binding StatusMessage}" Foreground="{StaticResource TextError}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>

        <Button Grid.Row="10" Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource VideoWall_OpenButton}" Height="32" VerticalAlignment="Top"
                Command="{Binding OpenCommand}"/>
    </Grid>
</Window>
