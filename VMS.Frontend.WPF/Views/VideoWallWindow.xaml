<Window x:Class="VMS.Frontend.WPF.Views.VideoWallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:vm="clr-namespace:VMS.Frontend.WPF.ViewModels"
        xmlns:conv="clr-namespace:VMS.Frontend.WPF.Converters"
        Title="{DynamicResource Win_VideoWall_Title}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="Black" KeyDown="Window_KeyDown">
    <Window.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="BoolToVisInverse"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:FractionToPixelConverter x:Key="FractionToPixel"/>

        <!-- Video-only tile: the wall is a passive display surface, not an interactive control
             surface, so there's no header/select/expand chrome here — just the camera name as a
             corner overlay (in a row the video can't paint over, per the usual airspace note),
             plus the same live known/unknown overlay as the Live View grid (see
             CameraTileViewModel.DetectionBoxes) — purely visual, never needs to be clickable. -->
        <DataTemplate DataType="{x:Type vm:CameraTileViewModel}">
            <Grid Margin="1">
                <vlc:VideoView MediaPlayer="{Binding Player}" Loaded="TileVideoView_Loaded"/>
                <TextBlock Text="{Binding Name}" Foreground="White" Background="#88000000"
                           Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                <Canvas x:Name="DetectionOverlay" Background="Transparent" IsHitTestVisible="False">
                    <ItemsControl ItemsSource="{Binding DetectionBoxes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LiveDetectionBoxViewModel}">
                                <Grid>
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource FractionToPixel}">
                                            <Binding Path="X"/>
                                            <Binding ElementName="DetectionOverlay" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Canvas.Left>
                                    <Canvas.Top>
                                        <MultiBinding Converter="{StaticResource FractionToPixel}">
                                            <Binding Path="Y"/>
                                            <Binding ElementName="DetectionOverlay" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Canvas.Top>
                                    <Rectangle Stroke="{Binding StrokeBrush}" StrokeThickness="2">
                                        <Rectangle.Width>
                                            <MultiBinding Converter="{StaticResource FractionToPixel}">
                                                <Binding Path="Width"/>
                                                <Binding ElementName="DetectionOverlay" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Rectangle.Width>
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource FractionToPixel}">
                                                <Binding Path="Height"/>
                                                <Binding ElementName="DetectionOverlay" Path="ActualHeight"/>
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                    <Border Background="#CC000000" Padding="3,0" Margin="0,-16,0,0"
                                            VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Label}" Foreground="{Binding StrokeBrush}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GridSlotViewModel}">
            <Grid Background="#111">
                <ContentPresenter Content="{Binding Tile}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInverse}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VideoWallCellViewModel}">
            <Grid Background="#111">
                <ContentPresenter Content="{Binding Tile}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInverse}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Mirror mode: the original behavior — just show whatever Live View's own grid shows. -->
        <ItemsControl ItemsSource="{Binding MainViewModel.GridSlots}"
                      Visibility="{Binding IsMirrorMode, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding DataContext.MainViewModel.GridSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 Columns="{Binding DataContext.MainViewModel.GridSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Layout mode: a saved Video Wall layout — cells can be different sizes (RowSpan/
             ColumnSpan from merges made in the layout editor), laid out on a real Grid whose
             row/column definitions are built once in LayoutGrid_Loaded from Rows/Columns. -->
        <ItemsControl ItemsSource="{Binding Cells}"
                      Visibility="{Binding IsMirrorMode, Converter={StaticResource BoolToVisInverse}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid Loaded="LayoutGrid_Loaded"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Row" Value="{Binding Row}"/>
                    <Setter Property="Grid.Column" Value="{Binding Column}"/>
                    <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </Grid>
</Window>
